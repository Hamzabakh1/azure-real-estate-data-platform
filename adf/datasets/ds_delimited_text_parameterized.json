{
  "name": "ds_delimited_text_parameterized",
  "properties": {
    "linkedServiceName": {
      "referenceName": "ls_adls_managed_identity",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "filesystem": { "type": "String" },
      "folderPath": { "type": "String" },
      "fileName": { "type": "String" }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": { "value": "@dataset().filesystem", "type": "Expression" },
        "folderPath": { "value": "@dataset().folderPath", "type": "Expression" },
        "fileName": { "value": "@dataset().fileName", "type": "Expression" }
      },
      "firstRowAsHeader": true,
      "quoteChar": "\"",
      "escapeChar": "\\",
      "columnDelimiter": ","
    }
  }
}
